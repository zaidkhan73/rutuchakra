generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model User {
  id                String       @id @default(uuid())
  clerkUserId       String       @unique
  email             String       @unique
  name              String?
  preferredLanguage String       @default("en")
  createdAt         DateTime     @default(now())
  predictions       Prediction[]
}

model Prediction {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  formInputJson  Json
  probability    Float
  topFactorsJson Json
  aiAdviceText   String
  modelVersion   String
  createdAt      DateTime @default(now())
}