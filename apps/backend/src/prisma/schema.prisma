generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model User {
  id                String        @id @default(uuid())
  clerkUserId       String        @unique
  email             String        @unique
  name              String?
  preferredLanguage String        @default("en")
  createdAt         DateTime      @default(now())
  predictions       Prediction[]
  cycleLogs         CycleLog[]
  habitLogs         HabitLog[]
  customHabits      CustomHabit[]
  chatMessages      ChatMessage[]
}

model Prediction {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  formInputJson  Json
  probability    Float
  topFactorsJson Json
  aiAdviceText   String
  modelVersion   String
  createdAt      DateTime @default(now())
}

model CycleLog {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
}

model HabitLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  habitName String
  value     Json
  isCustom  Boolean  @default(false)
}

model CustomHabit {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String
  unit      String?
  target    Float?
  icon      String?
  createdAt DateTime @default(now())
}

model KBChunk {
  id        String                      @id @default(uuid())
  title     String
  content   String
  embedding Unsupported("vector(768)")
  createdAt DateTime                    @default(now())
}

model ChatMessage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  role         String
  content      String
  language     String   @default("en")
  groundedInKB Boolean  @default(false)
  createdAt    DateTime @default(now())
}